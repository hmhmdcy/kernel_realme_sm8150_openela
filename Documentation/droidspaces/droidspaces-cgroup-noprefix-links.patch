Subject: [PATCH] cgroup: expose prefixed aliases on Android noprefix mounts

Adapted from DroidSpaces v6.6.0 non-GKI patch 02 by ravindu644,
commit 50cb2ccbef7d84852f2600bb4d3e69f6bd736561.
Use the v1 legacy controller name, unwind link creation failures,
and remove aliases when their control files are removed.

--- a/kernel/cgroup/cgroup.c
+++ b/kernel/cgroup/cgroup.c
@@ -1434,6 +1434,19 @@
 	return buf;
 }
 
+/* Expose conventional names without changing Android noprefix names. */
+static char *cgroup_file_alias_name(struct cgroup *cgrp,
+				   const struct cftype *cft, char *buf)
+{
+	if (!cft->ss || (cft->flags & CFTYPE_NO_PREFIX) ||
+	    !(cgrp->root->flags & CGRP_ROOT_NOPREFIX))
+		return NULL;
+
+	snprintf(buf, CGROUP_FILE_NAME_MAX, "%s.%s",
+		 cft->ss->legacy_name, cft->name);
+	return buf;
+}
+
 /**
  * cgroup_file_mode - deduce file mode of a control file
  * @cft: the control file in question
@@ -1589,6 +1602,9 @@
 		spin_unlock_irq(&cgroup_file_kn_lock);
 	}
 
+	/* Remove the link before dropping the target node. */
+	if (cgroup_file_alias_name(cgrp, cft, name))
+		kernfs_remove_by_name(cgrp->kn, name);
 	kernfs_remove_by_name(cgrp->kn, cgroup_file_name(cgrp, cft, name));
 }
 
@@ -3776,6 +3792,17 @@
 	if (ret) {
 		kernfs_remove(kn);
 		return ret;
+	}
+
+	if (cgroup_file_alias_name(cgrp, cft, name)) {
+		struct kernfs_node *alias;
+
+		alias = kernfs_create_link(cgrp->kn, name, kn);
+		if (IS_ERR(alias)) {
+			ret = PTR_ERR(alias);
+			kernfs_remove(kn);
+			return ret;
+		}
 	}
 
 	if (cft->file_offset) {
