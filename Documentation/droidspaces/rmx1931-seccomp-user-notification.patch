+/* 4.14 equivalent of check_zeroed_user: 1 zero, 0 nonzero, -EFAULT. */
+static int seccomp_check_zeroed_user(const void __user *user, unsigned int size)
+{
+	unsigned int offset = 0;
+	unsigned char bytes[64];
+	while (offset < size) {
+		unsigned int count = min_t(unsigned int, sizeof(bytes), size - offset);
+		if (copy_from_user(bytes, (const char __user *)user + offset, count))
+			return -EFAULT;
+		if (memchr_inv(bytes, 0, count))
+			return 0;
+		offset += count;
+	}
+	return 1;
+}
+
+static int seccomp_receive_fd(int fd, struct file *file, unsigned int flags)
+{
+	int ret, error;
+#ifdef CONFIG_NET
+	struct socket *sock;
+	int socket_error;
+#endif
+	error = security_file_receive(file);
+	if (error)
+		return error;
+	if (fd < 0) {
+		ret = get_unused_fd_flags(flags);
+		if (ret < 0)
+			return ret;
+		fd_install(ret, get_file(file));
+	} else {
+		ret = replace_fd(fd, file, flags);
+		if (ret < 0)
+			return ret;
+	}
+#ifdef CONFIG_NET
+	sock = sock_from_file(file, &socket_error);
+	if (sock) {
+		sock_update_netprioidx(&sock->sk->sk_cgrp_data);
+		sock_update_classid(&sock->sk->sk_cgrp_data);
+	}
+#endif
+	return ret;
+}
