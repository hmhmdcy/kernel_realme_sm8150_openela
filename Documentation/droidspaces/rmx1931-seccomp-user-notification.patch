+/* Extensible addfd ABI: reject nonzero future bytes, as copy_struct does. */
+static int seccomp_copy_addfd(struct seccomp_notif_addfd *arg,
+			     const void __user *user, unsigned int size)
+{
+	unsigned int copied = min_t(unsigned int, size, sizeof(*arg));
+	unsigned int offset = sizeof(*arg);
+	unsigned char tail[64];
+	memset(arg, 0, sizeof(*arg));
+	if (copy_from_user(arg, user, copied))
+		return -EFAULT;
+	while (offset < size) {
+		unsigned int bytes = min_t(unsigned int, sizeof(tail), size - offset);
+		if (copy_from_user(tail, (const char __user *)user + offset, bytes))
+			return -EFAULT;
+		if (memchr_inv(tail, 0, bytes))
+			return -E2BIG;
+		offset += bytes;
+	}
+	return 0;
+}
